  "meta": {
    "title": "Why does a request slow down on a cache miss?",
    "id": "mechanism",
    "locale": "en"
  },
  "answer": {
    "summary": "After a cache miss, the request waits for two extra stages: **the database query and the synchronous write-back to the cache**.",
    "reasons": [
      "On a hit, the API reads the cached value and returns.",
      "On a miss, the API must first obtain the database result.",
      "The synchronous write-back sits before the response, so the request ends only after the cache is written."
    ],
    "scope": "Cache-aside: GET returns empty, then PostgreSQL is queried, then a synchronous SET precedes the response; no parallelism, retries or other cache layers. Durations are unmeasured here and depend on the real path."
  },
  "panels": [
    {
      "id": "timeline",
      "title": "Where does the time go on one miss?",
      "blocks": [
        {
          "type": "steps",
          "id": "cache-path-steps",
          "items": [
